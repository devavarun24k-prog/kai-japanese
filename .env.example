# ==========================================
# KAI JAPANESE MASTERY PLATFORM — ENV CONFIG
# ==========================================

# Supabase Auth & Database (Mandatory for production; optional for local development)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Environment Mode ('development' or 'production')
VITE_APP_ENV=development

# Single-Owner Access Control (Recommended for private single-user deployment)
# Configure your authorized owner email here. When set, KAI disables public registration
# in the UI and immediately rejects/signs out any session that does not match this email.
# VITE_OWNER_EMAIL=owner@example.com

# NOTE ON AI SECRETS:
# Google Gemini API key (GEMINI_API_KEY) must NEVER be placed in VITE_ client variables.
# It is configured server-side in Supabase Secrets for the 'kai-tutor' Edge Function:
# supabase secrets set GEMINI_API_KEY=AIzaSy...

